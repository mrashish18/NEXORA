# NEXORA Backend Configuration
PORT=5000
HOST=0.0.0.0
DEBUG=False

# CORS: Comma-separated allowed origins or single production domain
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173,https://nexora-virid-xi.vercel.app

# Cloud LLM Configuration (OpenAI or OpenRouter)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_api_key_here
# Optional: Set base URL for OpenRouter (https://openrouter.ai/api/v1) or other OpenAI-compatible gateways
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
